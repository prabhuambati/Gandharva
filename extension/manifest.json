{
  "manifest_version": 3,
  "name": "Reelroom \u2014 Public Reel Collector",
  "version": "0.2.0",
  "description": "Collect visible public Instagram reel links and attribution metadata for a local research collection.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
