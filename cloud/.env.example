# Copy to a private .env file; never commit real credentials.
# The local SQLite app does NOT switch to cloud mode just because this file exists.
GANDHARVA_ENV=staging
GANDHARVA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
GANDHARVA_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SERVER ONLY: never include in frontend bundles, screenshots or GitHub.
GANDHARVA_SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
GANDHARVA_ALLOWED_ORIGIN=http://127.0.0.1:8765
GANDHARVA_AUDIO_BUCKET=gandharva-audio
GANDHARVA_ARTWORK_BUCKET=gandharva-artwork
